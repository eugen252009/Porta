{
  "manifest_version": 3,
  "name": "Send to Porta",
  "version": "0.1.0",
  "description": "Send a selected ChatGPT assistant artifact to an authorized Porta node.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["porta-client.js", "content.js"],
    "run_at": "document_idle"
  }]
}
