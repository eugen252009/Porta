{
  "model": {
    "provider": "openai-codex",
    "model": "gpt-5.6-luna",
    "timeoutMs": 120000,
    "maxResponseBytes": 8388608
  },
  "tools": [],
  "authorization": {
    "mode": "require-approval"
  },
  "filesystem": {
    "root": "/workspace",
    "mutation": {
      "enabled": true
    }
  },
  "execution": {
    "enabled": true,
    "allowedCommands": [
      "git",
      "go",
      "node",
      "npm",
      "python3",
      "rustc",
      "cargo",
      "mema"
    ],
    "filesystem": "allow",
    "network": "allow",
    "codeLoading": "allow",
    "sandbox": {
      "preference": ["sandbox.host-process"]
    }
  },
  "git": {
    "enabled": true
  },
  "persistence": {
    "enabled": true,
    "driver": "sqlite",
    "path": "/data/porta.db"
  },
  "web": {
    "targets": [],
    "port": 4173
  }
}
